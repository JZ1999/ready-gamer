0x7f,0x7f,0x7f,0x41,0x51,0x7f,0x45,0x7f,0x7f,0x41,0x7f,0x5d,0x7f,0x7f,0x7e,0x7e,
0x80,0x80,0xfc,0xfc,0xfc,0x84,0xe4,0x9c,0xe4,0x9c,0xfc,0x9c,0xfc,0xfc,0x18,0x18,
0xfe,0xfe,0xfe,0x82,0x8a,0xfe,0xa2,0xfe,0xfe,0x82,0xfe,0xba,0xfe,0xfe,0x7e,0x7e,
0x01,0x00,0x3f,0x00,0x3f,0x1e,0x27,0x1e,0x27,0x1e,0x3f,0x06,0x3f,0x00,0x18,0x18,
0x7f,0x7f,0x7f,0x41,0x51,0x7f,0x45,0x7f,0x7f,0x41,0x7f,0x5d,0x7f,0x7f,0x7e,0x7e,
0x80,0x00,0xfc,0x00,0xfc,0x78,0xe4,0x78,0xe4,0x78,0xfc,0x60,0xfc,0x00,0x18,0x18,
0xfe,0xfe,0xfe,0x82,0x8a,0xfe,0xa2,0xfe,0xfe,0x82,0xfe,0xba,0xfe,0xfe,0x7e,0x7e
